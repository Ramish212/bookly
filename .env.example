# ── Supabase ─────────────────────────────────────────────
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# ── Google Calendar OAuth ─────────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: http://localhost:5173/gcal (dev) + your prod URL
VITE_GOOGLE_CLIENT_ID=""

# GOOGLE_CLIENT_SECRET goes in Supabase Edge Function secrets ONLY — never in .env
# Set it via: supabase secrets set GOOGLE_CLIENT_SECRET=your_secret_here

# ── Gemini AI (optional — for tagline generator) ─────────
VITE_GEMINI_API_KEY=""
